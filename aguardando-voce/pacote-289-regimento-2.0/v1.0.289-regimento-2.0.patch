@@ -0,0 +1,67 @@
+"""v1.0.289 (Dom 24/11/2026, "Regimento 2.0"): o regimento do sistema passa a ser o 2.0 do HOTEL BOUTIQUE, copiado da
+aba principal do Claude Doc "Regimento 2.0" (a aba "Uso interno" nao vai ao hospede), nos 7 idiomas. Descreve a casa
+como estara em 27/11: um passe so (quarto das 14h as 11h), cozinha, quintal e coworking para todos, Wi-Fi pelo portal
+com a senha da estadia, cameras nas posicoes do Anexo e pagamentos so em reais pelo link da estadia ou pela plataforma."""
+from __future__ import annotations
+
+import re
+
+from app.reservation import regimento as RG
+from app.reservation.regimento_textos import TEXTOS
+
+SECOES = [str(n) for n in range(19)]                                 # 0 a 18 (16 Base legal, 17 Anexo, 18 Historico)
+LITERAIS = ("R$ 5", "R$ 8", "R$ 15", "R$ 17", "R$ 20", "R$ 35", "98306-9951", "11.343/2006", "11.577/2007",
+            "13.709/2018", "66.547.650/0001-60", "@banana", "FNRH", "01–05", "06–11", "12–14", "22 °C")
+
+
+def _secoes(texto: str) -> list[str]:
+    return [m.group(1) for m in (re.match(r"^(\d{1,2})\. ", l) for l in texto.splitlines()) if m]
+
+
+def test_versao_20_e_secoes_0_a_18_nos_7_idiomas():
+    assert RG.VERSAO == "2.0"
+    pt = RG.TEXTO.splitlines()
+    assert pt[0] == "REGIMENTO DO HOTEL DOM BANANA — HOTEL BOUTIQUE" and "Versão 2.0" in pt[1]
+    assert _secoes(RG.TEXTO) == SECOES
+    assert "16. BASE LEGAL" in RG.TEXTO and "17. ANEXO IPIRANGA (VERSÃO 2.0)" in RG.TEXTO
+    assert set(TEXTOS) == {"en", "es", "fr", "de", "ja", "zh"}
+    for cod, texto in TEXTOS.items():
+        linhas = texto.splitlines()
